version: 2.1
parameters:
  publish_toolchain_image:
    type: boolean
    default: false
  build_toolchain_image:
    type: boolean
    default: false
jobs:
  validate-toolchain-image:
    docker:
      - image: cimg/base:stable
    resource_class: small
    steps:
      - checkout
      - setup_remote_docker
      - run:
          name: Build and validate reusable cpp-qt5-ubuntu2204 without publishing
          no_output_timeout: 20m
          command: |
            set -euo pipefail
            docker build --pull --progress=plain -t ci-foundry/cpp-qt5-ubuntu2204:candidate ci/images/cpp-builder
            docker run --rm ci-foundry/cpp-qt5-ubuntu2204:candidate sh -c 'cmake --version && g++ --version && pkg-config --modversion Qt5Core'
            docker image inspect ci-foundry/cpp-qt5-ubuntu2204:candidate --format '{{.Id}}'
            echo 'Validated locally; image NOT published or digest-certified.'
  publish-toolchain-image:
    docker:
      - image: cimg/base:stable
    resource_class: small
    steps:
      - checkout
      - setup_remote_docker
      - run:
          name: Build validate and publish private qt5 toolchain image
          no_output_timeout: 20m
          command: |
            set -euo pipefail
            : "${GHCR_USERNAME:?Missing GHCR_USERNAME}"
            : "${GHCR_TOKEN:?Missing GHCR_TOKEN}"
            image="ghcr.io/sudipdasin/tux-steward-qt5-builder"
            docker build --pull --progress=plain -t "${image}:${CIRCLE_SHA1}" ci/images/cpp-builder
            docker run --rm "${image}:${CIRCLE_SHA1}" sh -c 'cmake --version && g++ --version && pkg-config --modversion Qt5Core'
            printf '%s' "${GHCR_TOKEN}" | docker login ghcr.io -u "${GHCR_USERNAME}" --password-stdin
            docker push "${image}:${CIRCLE_SHA1}"
            docker logout ghcr.io
            echo 'Publication completed; verify package is private and capture registry digest before reuse.'

  cpp-smoke:
    docker:
      - image: ubuntu:22.04
    resource_class: small
    steps:
      - checkout
      - run:
          name: Install Qt5 and CMake
          command: apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y cmake g++ qtbase5-dev dpkg-dev file desktop-file-utils
      - run:
          name: Compile and run tests with one compiler
          command: |
            cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=g++
            cmake --build build --parallel 2
            ctest --test-dir build --output-on-failure
      - run:
          name: Build private beta packages
          command: |
            export SOURCE_DATE_EPOCH="$(git log -1 --format=%ct)"
            cpack --config build/CPackConfig.cmake
            cmake -DPACKAGE_DIR="$PWD/build/packages" -DRELEASE_VERSION="$(./build/tux-steward --version | awk '{print $NF}')" -P tests/verify_packages.cmake
            mkdir -p artifacts/beta
            cp build/packages/*.deb build/packages/*.tar.gz artifacts/beta/
            cd artifacts/beta
            sha256sum *.deb *.tar.gz > SHA256SUMS
      - store_artifacts:
          path: artifacts/beta
          destination: beta-packages
workflows:
  manual-toolchain-image-publication:
    when: << pipeline.parameters.publish_toolchain_image >>
    jobs:
      - publish-toolchain-image:
          context: ghcr-publisher
          filters:
            branches:
              only: main
  manual-toolchain-image-validation:
    when: << pipeline.parameters.build_toolchain_image >>
    jobs:
      - validate-toolchain-image:
          filters:
            branches:
              only: main
  cpp-ci:
    # CI_MASTER_TOGGLE: managed by scripts/ci-master-toggle.py
    when: false
    jobs:
      - cpp-smoke:
          filters:
            branches:
              only: main

