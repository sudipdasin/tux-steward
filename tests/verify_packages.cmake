# Run after CPack. Reject incomplete distro metadata before retaining artifacts.
if(NOT DEFINED PACKAGE_DIR OR NOT DEFINED RELEASE_VERSION)
    message(FATAL_ERROR "Package directory and release version are required")
endif()
find_program(DPKG_DEB dpkg-deb)
if(NOT DPKG_DEB)
    message(FATAL_ERROR "dpkg-deb is required to verify packages")
endif()
file(GLOB debs "${PACKAGE_DIR}/*.deb")
file(GLOB archives "${PACKAGE_DIR}/*.tar.gz")
file(GLOB zips "${PACKAGE_DIR}/*.zip")
list(LENGTH debs deb_count)
list(LENGTH archives archive_count)
list(LENGTH zips zip_count)
if(NOT deb_count EQUAL 1 OR NOT archive_count EQUAL 1 OR NOT zip_count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one DEB, one TGZ and one ZIP; use a clean package directory")
endif()
list(GET debs 0 deb)
execute_process(COMMAND "${DPKG_DEB}" --field "${deb}" Depends
    RESULT_VARIABLE result OUTPUT_VARIABLE depends OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0 OR NOT depends MATCHES "libqt5widgets5" OR NOT depends MATCHES "libqt5core5" OR NOT depends MATCHES "libc6" OR NOT depends MATCHES "libstdc[+][+]6")
    message(FATAL_ERROR "Missing required dynamic dependency metadata. Build DEBs on a distribution with installed package metadata; do not distribute this package. Depends=${depends}")
endif()
set(extracted "${PACKAGE_DIR}/verify-extracted")
file(REMOVE_RECURSE "${extracted}")
execute_process(COMMAND "${DPKG_DEB}" --extract "${deb}" "${extracted}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot extract Debian package")
endif()
foreach(program IN ITEMS syspulse tux-steward tux-task-manager tux-setup)
    set(binary "${extracted}/usr/bin/${program}")
    execute_process(COMMAND "${binary}" --version RESULT_VARIABLE result OUTPUT_VARIABLE version)
    string(FIND "${version}" "${RELEASE_VERSION}" found)
    if(NOT result EQUAL 0 OR found LESS 0)
        message(FATAL_ERROR "Packaged binary version check failed: ${program}")
    endif()
    file(STRINGS "${binary}" private_paths REGEX "/(workspace|home|Users)/")
    if(private_paths)
        message(FATAL_ERROR "Packaged binary contains private build paths: ${program}")
    endif()
endforeach()
file(REMOVE_RECURSE "${extracted}")
message(STATUS "Debian dependencies, packaged versions and binary build-path privacy verified")

# Verify both executable archives, including version, private path and execute bits.
foreach(archive IN LISTS archives zips)
    set(archive_root "${PACKAGE_DIR}/verify-archive")
    file(REMOVE_RECURSE "${archive_root}")
    file(MAKE_DIRECTORY "${archive_root}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}" WORKING_DIRECTORY "${archive_root}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cannot extract executable archive: ${archive}")
    endif()
    foreach(program IN ITEMS syspulse tux-steward tux-task-manager tux-setup)
        set(binary "${archive_root}/usr/bin/${program}")
        execute_process(COMMAND "${binary}" --version RESULT_VARIABLE result OUTPUT_VARIABLE version)
        string(FIND "${version}" "${RELEASE_VERSION}" found)
        if(NOT result EQUAL 0 OR found LESS 0)
            message(FATAL_ERROR "Archive executable/version check failed: ${program}")
        endif()
        file(STRINGS "${binary}" private_paths REGEX "/(workspace|home|Users)/")
        if(private_paths)
            message(FATAL_ERROR "Archive executable contains private build paths: ${program}")
        endif()
    endforeach()
    file(REMOVE_RECURSE "${archive_root}")
endforeach()
message(STATUS "ZIP/TGZ executable permissions, versions and build-path privacy verified")
