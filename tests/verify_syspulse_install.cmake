if(NOT DEFINED BUILD_DIR OR NOT DEFINED RELEASE_VERSION)
    message(FATAL_ERROR "Build directory and release version are required")
endif()
set(prefix "${BUILD_DIR}/syspulse-install-test")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --prefix "${prefix}"
    RESULT_VARIABLE installed OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT installed EQUAL 0)
    message(FATAL_ERROR "SysPulse installation failed: ${error}")
endif()
execute_process(COMMAND "${prefix}/bin/syspulse" --version RESULT_VARIABLE code OUTPUT_VARIABLE version)
if(NOT code EQUAL 0 OR NOT version MATCHES "SysPulse ${RELEASE_VERSION}")
    message(FATAL_ERROR "Installed SysPulse version check failed: ${version}")
endif()
execute_process(COMMAND "${prefix}/bin/syspulse" --help RESULT_VARIABLE code OUTPUT_VARIABLE help)
if(NOT code EQUAL 0 OR NOT help MATCHES "Usage:")
    message(FATAL_ERROR "Installed SysPulse help check failed")
endif()
foreach(path IN ITEMS share/applications/syspulse.desktop share/icons/hicolor/scalable/apps/syspulse.svg
    share/doc/syspulse/LICENSE share/doc/syspulse/PRIVACY.md share/doc/syspulse/SYSPULSE_MILESTONE.md)
    if(NOT EXISTS "${prefix}/${path}")
        message(FATAL_ERROR "Missing SysPulse installed file: ${path}")
    endif()
endforeach()
file(READ "${prefix}/share/applications/syspulse.desktop" desktop)
if(NOT desktop MATCHES "Exec=syspulse" OR NOT desktop MATCHES "Icon=syspulse" OR NOT desktop MATCHES "Terminal=false")
    message(FATAL_ERROR "Incorrect SysPulse desktop entry")
endif()
message(STATUS "SysPulse installed executable, version, help, desktop entry, icon and documents verified")
