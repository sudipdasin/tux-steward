if(NOT DEFINED BUILD_DIR OR NOT DEFINED RELEASE_VERSION)
    message(FATAL_ERROR "Build directory and release version are required")
endif()
set(prefix "${BUILD_DIR}/install-test")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --prefix "${prefix}"
    RESULT_VARIABLE installed OUTPUT_VARIABLE install_output ERROR_VARIABLE install_error)
if(NOT installed EQUAL 0)
    message(FATAL_ERROR "Installation failed: ${install_error}")
endif()
foreach(program IN ITEMS tux-steward tux-task-manager tux-setup)
    if(NOT EXISTS "${prefix}/bin/${program}" OR NOT EXISTS "${prefix}/share/applications/${program}.desktop")
        message(FATAL_ERROR "Missing installed program or desktop entry: ${program}")
    endif()
    execute_process(COMMAND "${prefix}/bin/${program}" --version RESULT_VARIABLE status OUTPUT_VARIABLE version ERROR_VARIABLE error)
    if(NOT status EQUAL 0 OR NOT version MATCHES "${RELEASE_VERSION}")
        message(FATAL_ERROR "Installed headless version check failed: ${program}: ${error}")
    endif()
    execute_process(COMMAND "${prefix}/bin/${program}" --help RESULT_VARIABLE status OUTPUT_VARIABLE help)
    if(NOT status EQUAL 0 OR NOT help MATCHES "Usage:")
        message(FATAL_ERROR "Installed headless help check failed: ${program}")
    endif()
    file(READ "${prefix}/share/applications/${program}.desktop" desktop)
    if(NOT desktop MATCHES "Exec=${program}" OR NOT desktop MATCHES "Terminal=false")
        message(FATAL_ERROR "Invalid installed desktop entry: ${program}")
    endif()
endforeach()
foreach(document IN ITEMS LICENSE PRIVACY.md BETA_READINESS.md)
    if(NOT EXISTS "${prefix}/share/doc/tux-steward/${document}")
        message(FATAL_ERROR "Missing installed document: ${document}")
    endif()
endforeach()
message(STATUS "Installed binaries, headless information options and desktop entries verified")
